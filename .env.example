# ---------------------------------------------------------------------------
# Click through the whole app with sample Idaho data — no database, no Clerk.
# This is how the demo runs today, since there is no real course list yet.
# ---------------------------------------------------------------------------
VITE_USE_MOCK=true

# ---------------------------------------------------------------------------
# Frontend — required when VITE_USE_MOCK is not true
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.example.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ---------------------------------------------------------------------------
# API (server/) — never exposed to the browser
# ---------------------------------------------------------------------------
CLERK_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist. Leave empty to allow any signed-in Clerk user.
ALLOWED_EMAILS=

# Vercel Cron sends this automatically once set in project settings.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Phase 2 — headcount reminder email (optional)
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Phase 3 — SMS reminders. Not wired up yet: this also depends on confirming
# Teegle's 10DLC campaign use-case covers event-registration reminders.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
